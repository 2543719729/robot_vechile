<launch>
  <!-- Arguments -->
  <arg name="slam_methods" default="gmapping" doc="slam type [gmapping, cartographer, hector, karto, frontier_exploration, rrt_exploration]"/>
  <arg name="configuration_basename" default="oryxbot_lds_2d.lua" />
  <arg name="open_rviz" default="false"/>

  <!--加载oryxbot model description-->
  <arg name="model" default="$(find xacro)/xacro --inorder '$(find bobac3_description)/xacro/bobac3_serverbot.xacro'" />
  <param name="robot_description" command="$(arg model)" />

  <node
    name="joint_state_publisher"
    pkg="joint_state_publisher"
    type="joint_state_publisher" />
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />

  <!-- oryxbot base & kinematics-->  
  <include file="$(find rei_robot_base)/launch/oryxbot_base.launch" /> 
  <include file="$(find robot_joy)/launch/robot_joy.launch" />
	<!--laser sensor激光雷达-->
	<include file="$(find rei_ydlidar_nodelet)/launch/nodelet_2_lidar.launch" />

  <!-- SLAM: Gmapping, Cartographer, Hector, Karto, Frontier_exploration, RTAB-Map -->
  <include file="$(find oryxbot_slam)/launch/oryxbot_$(arg slam_methods).launch" >   
    <arg name="configuration_basename" value="$(arg configuration_basename)" />
  </include>

  <!-- rviz -->
  <group if="$(arg open_rviz)"> 
    <node pkg="rviz" type="rviz" name="rviz" required="true"
          args="-d $(find oryxbot_slam)/rviz/oryxbot_$(arg slam_methods).rviz"/>
  </group>
</launch>
