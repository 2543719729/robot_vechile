<launch>
    <!-- 语音导航节点 -->
    <node pkg="bobac3_audio" type="voice_nav_node" name="voice_nav" output="screen"/>
    <!-- 打开语音采集节点 -->
    <node name="voice_collect" pkg="bobac3_audio" type="voice_collect_node" output="screen">
        <!-- 音频文件目录 -->
        <param name="audio_file" type="string" value="./AIUI/audio/audio.wav"/>
    </node>
    <!-- 打开语音服务 -->
    <node pkg="bobac3_audio" type="voice_aiui_node" name="voice_aiui_node"/>
</launch>
