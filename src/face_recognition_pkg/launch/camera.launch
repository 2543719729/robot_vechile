<?xml version="1.0"?>
<launch>
    <!-- 摄像头节点启动文件 -->
    
    <!-- 参数 -->
    <arg name="camera_id" default="0" doc="摄像头设备ID"/>
    <arg name="frame_rate" default="30" doc="帧率"/>
    <arg name="image_width" default="640" doc="图像宽度"/>
    <arg name="image_height" default="480" doc="图像高度"/>
    
    <!-- 摄像头节点 -->
    <node pkg="face_recognition_pkg" type="camera_node.py" name="camera_node" output="screen">
        <param name="camera_id" value="$(arg camera_id)"/>
        <param name="frame_rate" value="$(arg frame_rate)"/>
        <param name="image_width" value="$(arg image_width)"/>
        <param name="image_height" value="$(arg image_height)"/>
    </node>
</launch>
